# --- AI counterpart (any OpenAI-compatible Chat Completions endpoint, e.g. 0G Compute) ---
# Without LLM_API_KEY the app runs an offline heuristic demo so it never breaks.
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Optional: a stronger model for the end-of-session report. claude-* models automatically use the Anthropic Messages format
# (override with LLM_API_FORMAT=openai|anthropic).
LLM_REPORT_MODEL=claude-sonnet-5

# --- RevenueCat (see docs/REVENUECAT_SETUP.md) ---
# SANDBOX public key: Test Store (test_...) or Web Billing sandbox (rcb_sb_...). No real money.
# Without it, the paywall runs in a labelled demo-billing mode.
NEXT_PUBLIC_REVENUECAT_API_KEY=
# LIVE public key: Web Billing production (rcb_...). Enables the Sandbox <-> Live switch; real Stripe charges.
NEXT_PUBLIC_REVENUECAT_LIVE_API_KEY=
# Optional server-only secret key (sk_...) for entitlement verification. When unset, the server
# verifies with the environment's public key via GET /v1/subscribers/{id}.
REVENUECAT_SECRET_API_KEY=
# Shared secret RevenueCat sends in the Authorization header of webhook calls (Integrations -> Webhooks).
REVENUECAT_WEBHOOK_AUTH=

# --- Custom scenario sealing (AES-256-GCM). Optional: falls back to a key derived from LLM_API_KEY. ---
SCENAR_SEAL_SECRET=

# --- Public site URL (Open Graph / sitemap) ---
NEXT_PUBLIC_SITE_URL=
