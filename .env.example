# --- AI counterpart (any OpenAI-compatible Chat Completions endpoint, e.g. 0G Compute) ---
# Without LLM_API_KEY the app runs an offline heuristic demo so it never breaks.
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Optional: a stronger model for the end-of-session report. claude-* models automatically use the Anthropic Messages format
# (override with LLM_API_FORMAT=openai|anthropic).
LLM_REPORT_MODEL=claude-sonnet-5

# --- RevenueCat Web Billing (see docs/REVENUECAT_SETUP.md) ---
# Public Web Billing key (sandbox keys start with rcb_sb_). Without it, the paywall runs in demo mode.
NEXT_PUBLIC_REVENUECAT_API_KEY=

# --- Custom scenario sealing (AES-256-GCM). Optional: falls back to a key derived from LLM_API_KEY. ---
SCENAR_SEAL_SECRET=

# --- Public site URL (Open Graph / sitemap) ---
NEXT_PUBLIC_SITE_URL=
